# 前端对外端口（容器内 backend 仍是 8418，nginx 已下线，前端直接由 Go 嵌入 serve）
HTTP_PORT=8080

# 拉取的镜像 tag
IMAGE_TAG=latest

# Backend 运行模式 / 日志等级
SERVER_MODE=release
LOG_LEVEL=info

# 默认 docker-compose.yml：PostgreSQL + Redis。POSTGRES_PASSWORD 必填。
POSTGRES_DB=upstreamops
POSTGRES_USER=upstreamops
POSTGRES_PASSWORD=change-me
# Redis 内存上限（只放缓存 / 锁，满了按 LRU 淘汰）
REDIS_MAXMEMORY=256mb

# 本地直跑 / 自定义部署可用的连接参数（compose 里已按服务名配好，一般不用改）：
# DATABASE_DRIVER=postgres          # postgres | sqlite | mysql
# DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require   # 设置后优先于下面分项
# DATABASE_HOST=postgres
# DATABASE_PORT=5432
# DATABASE_SSLMODE=disable
# REDIS_URL=redis://:password@host:6379/0   # 或 REDIS_ADDR / REDIS_PASSWORD / REDIS_DB
# REDIS_KEY_PREFIX=flowrouter:

# docker-compose.sqlite.yml（单文件 SQLite）使用
DATABASE_PATH=/app/data/upstream-ops.db

# 叠加 docker-compose.mysql.yml 时使用这组 MySQL 参数
MYSQL_DATABASE=upstreamops
MYSQL_USER=upstreamops
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PORT=33069

# 主密钥（任意长度，至少 32 字节随机串），用于 AES-GCM 加密敏感字段。
# **必填** — 修改后既有数据无法解密，请务必妥善保存。
APP_SECRET=please-change-me-to-a-long-random-secret-32bytes-min

# 鉴权开关。默认 false = 任何人访问 /api/* 都不需要登录（纯内网 / 反代后部署用）。
# 公网暴露请设 AUTH_ENABLED=true 并同时填好 ADMIN_PASSWORD。
AUTH_ENABLED=false

# 后台登录账号 / 密码。仅在 AUTH_ENABLED=true 时生效；AUTH_ENABLED=false 时可留空。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# token 签名密钥；留空时回退使用 APP_SECRET
AUTH_TOKEN_SECRET=
